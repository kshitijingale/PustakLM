# Postgres (Neon) - used for users, notebooks, sources metadata
DATABASE_URL="postgres://user:password@ep-xxxx.neon.tech/pustaklm?sslmode=require"

# Qdrant Cloud - used for vector storage (one collection per user)
QDRANT_URL="https://xxxx.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"

# OpenAI - embeddings + chat completions
OPENAI_API_KEY="sk-..."
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# App
# Optional: forces the canonical host used to build OAuth callback URLs.
# Leave it unset to auto-use each request's origin (recommended when you run
# both localhost and a hosted deployment). If set, it must match the URL
# users actually visit.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth (Google + GitHub sign-in)
# Google: https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID (Web),
#         authorized redirect URI: http://localhost:3000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers -> OAuth Apps -> New OAuth App,
#         authorization callback URL: http://localhost:3000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
